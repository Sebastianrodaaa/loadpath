{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "loadpath",
          "version": "0.1.0",
          "rules": [
            {
              "id": "LP001",
              "name": "pickle-deserialization",
              "shortDescription": {
                "text": "Pickle deserialization can execute code."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP002",
              "name": "extended-pickle",
              "shortDescription": {
                "text": "dill and cloudpickle restore executable Python objects."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP003",
              "name": "joblib-load",
              "shortDescription": {
                "text": "Joblib may deserialize executable objects, including compressed streams."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP004",
              "name": "torch-load",
              "shortDescription": {
                "text": "Unrestricted torch.load can execute code; weights_only changes the loading policy."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP005",
              "name": "torchscript-load",
              "shortDescription": {
                "text": "TorchScript is executable model code, not just weights."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP006",
              "name": "numpy-pickle",
              "shortDescription": {
                "text": "allow_pickle=True permits object deserialization."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP007",
              "name": "pandas-pickle",
              "shortDescription": {
                "text": "read_pickle restores executable Python objects."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP008",
              "name": "keras-load",
              "shortDescription": {
                "text": "safe_mode=False and legacy HDF5 models require special review."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "LP009",
              "name": "savedmodel-load",
              "shortDescription": {
                "text": "SavedModel restores executable computation graphs."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP010",
              "name": "remote-model-code",
              "shortDescription": {
                "text": "trust_remote_code=True permits repository code execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LP011",
              "name": "hub-download",
              "shortDescription": {
                "text": "Download provenance is context, not scanner coverage."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "1.0"
              }
            },
            {
              "id": "LP012",
              "name": "skops-load",
              "shortDescription": {
                "text": "Review the trusted types passed to skops.io.load."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "LP013",
              "name": "safetensors-load",
              "shortDescription": {
                "text": "Data-only safetensors loading; this is not a certificate for surrounding code."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "1.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "LP001",
          "level": "error",
          "message": {
            "text": "pickle.load: Pickle can execute code. Coverage: covered."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo_app/app.py"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "coverage": "covered",
            "args": {}
          }
        },
        {
          "ruleId": "LP004",
          "level": "error",
          "message": {
            "text": "torch.load: weights_only='<missing>'; PyTorch >=2.6 defaults to True when pickle_module is not passed; installed version and custom pickle_module are not inferred. Coverage: uncovered."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo_app/app.py"
                },
                "region": {
                  "startLine": 11,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "coverage": "uncovered",
            "args": {}
          }
        },
        {
          "ruleId": "LP001",
          "level": "error",
          "message": {
            "text": "pickle.loads: Pickle can execute code. Coverage: uncovered."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo_app/app.py"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "coverage": "uncovered",
            "args": {}
          }
        },
        {
          "ruleId": "LP003",
          "level": "error",
          "message": {
            "text": "joblib.load: Joblib can execute code. Coverage: unsupported-format."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo_app/app.py"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "coverage": "unsupported-format",
            "args": {}
          }
        },
        {
          "ruleId": "LP001",
          "level": "error",
          "message": {
            "text": "pickle.load: Pickle can execute code. Coverage: unresolved."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo_app/app.py"
                },
                "region": {
                  "startLine": 18,
                  "startColumn": 12
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "coverage": "unresolved",
            "args": {}
          }
        },
        {
          "ruleId": "LP013",
          "level": "note",
          "message": {
            "text": "safetensors.torch.load_file: Data-only format; informational inventory. Coverage: not-required."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo_app/app.py"
                },
                "region": {
                  "startLine": 21,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "info",
            "coverage": "not-required",
            "args": {}
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ]
    }
  ]
}
